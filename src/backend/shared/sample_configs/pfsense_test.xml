<?xml version="1.0"?>
<pfsense>
	<version>21.5</version>
	<system>
		<hostname>pfsense-demo</hostname>
		<domain>example.local</domain>
		<enablesshd>enabled</enablesshd>
		<webgui>
			<session_timeout>10</session_timeout>
		</webgui>
		<user>
			<name>admin</name>
			<password>$2b$10$abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ012</password>
		</user>
	</system>
	<syslog>
		<remoteserver>10.0.0.5</remoteserver>
	</syslog>
	<snmpd>
		<syslocation></syslocation>
		<rocommunity>public</rocommunity>
	</snmpd>
	<interfaces>
		<wan>
			<if>em0</if>
			<ipaddr>10.10.10.1</ipaddr>
		</wan>
		<lan>
			<if>em1</if>
			<ipaddr>192.168.1.1</ipaddr>
		</lan>
	</interfaces>
</pfsense>
