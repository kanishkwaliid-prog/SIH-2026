# Copy to .env and fill in. .env is gitignored; this file is not.

GROQ_API_KEY=

# Signs login tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Every teammate can use their own locally. Changing it logs everyone out.
JWT_SECRET=

# Password for the seeded demo accounts (Phase 1). Keep it out of git.
DEMO_PASSWORD=

# Origins allowed to call this API, comma-separated (Phase 6). Defaults
# to http://localhost:5500 -- the README's `python3 -m http.server 5500`
# frontend dev server -- if left unset.
FRONTEND_ORIGINS=
